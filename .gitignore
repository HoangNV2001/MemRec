# source CSVs above remain at data/ for compatibility with Kaggle.
data/temporal_amazon_books_2014/*
!data/temporal_amazon_books_2014/.gitkeep

# Results & checkpoints
results/
checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
