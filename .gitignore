# Secrets
.env
.env.*
!.env.example
secrets/
# Cluster access/runbook contains internal host/account/job details. Keep it
# local like the source project's internal_docs policy.
internal_docs/

# Data (large, not tracked)
data/iagent/
data/amazon_books/raw/*
data/processed/*
!data/processed/.gitkeep
# Amazon Books artifacts are fully derived. Keep a directory marker only.
data/amazon_books/artifacts/*
!data/amazon_books/artifacts/.gitkeep

# Results & checkpoints
results/
checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
