# Copy this file to .env and fill in your real key. .env is gitignored.
#
# Plain OpenAI (not Azure) — this is what configs/*openai* configs expect.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Only needed if you switch a config's provider.name back to azure_openai.
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
# AZURE_OPENAI_API_KEY=
