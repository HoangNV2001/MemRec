# Copy this file to .env and fill in your real key. .env is gitignored.
#
# Active Azure OpenAI configuration. The `azure/` prefix is accepted for
# compatibility with the supplied model name and stripped before the Azure SDK
# sends the deployment name.
LLM__BASE_URL=https://cpht-360-vivi-brain-dev-20260624.openai.azure.com/
LLM__API_KEY=
LLM__API_VERSION=2024-05-01-preview
LLM__MODEL_NAME=azure/gpt-5.4-mini

# Legacy aliases are still supported for older configs/scripts.
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-05-01-preview
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
